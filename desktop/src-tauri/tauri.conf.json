{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jakal-search",
  "version": "0.1.0",
  "identifier": "com.jakal.search",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "jakal-search compare",
        "width": 1600,
        "height": 1024,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
